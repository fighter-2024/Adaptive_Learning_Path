# Copy to server/.env and replace local-only values before starting the backend.
# Never commit server/.env, real passwords, API keys, or certificates.

APP_NAME=Adaptive Learning System
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-neo4j-password

SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=adaptive_learning
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=replace-with-local-sqlserver-password
SQLSERVER_TRUSTED_CONNECTION=no
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

DINA_EM_MAX_ITERATIONS=500
DINA_EM_CONVERGENCE_THRESHOLD=0.001
DINA_S_INITIAL=0.2
DINA_G_INITIAL=0.2

PATH_WEIGHT_MASTERY=0.4
PATH_WEIGHT_TARGET_DISTANCE=0.3
PATH_WEIGHT_DIFFICULTY=0.2
PATH_WEIGHT_TIME_COST=0.1
PATH_WEIGHT_PROFILE=default-v1

SECRET_KEY=change-me-in-development
JWT_EXPIRE_MINUTES=1440

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
